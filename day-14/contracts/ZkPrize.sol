pragma solidity 0.8.24;

/// @dev The verifier generated by snarkjs from circuits/secret.circom.
interface ISecretVerifier {
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[2] calldata publicSignals // [hash, recipient]
    ) external view returns (bool);
}

/// @title ZkPrize — the ETH inside goes to whoever PROVES they know the secret, without revealing it.
/// @notice The contract stores only Poseidon(secret). A Groth16 proof convinces it that the caller
///         knows a matching secret. The proof also names the `recipient`, so copying a proof from
///         the mempool and swapping in your own address makes it invalid (no front-running).
/// @dev Anyone may SUBMIT the proof (e.g. a relayer paying the gas): the money still goes to `recipient`.
contract ZkPrize {
    /// @dev BN254 scalar field. Public signals are numbers modulo this prime.
    uint256 internal constant SNARK_FIELD =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    ISecretVerifier public immutable verifier;
    uint256 public immutable secretHash;
    bool public claimed;

    event Claimed(address indexed recipient, address indexed submittedBy, uint256 amount);

    error HashNotInField();
    error EmptyPrize();
    error AlreadyClaimed();
    error InvalidProof();
    error ZeroRecipient();
    error RecipientIsPrize();
    error TransferFailed();

    constructor(ISecretVerifier verifier_, uint256 secretHash_) payable {
        if (secretHash_ >= SNARK_FIELD) revert HashNotInField();
        if (msg.value == 0) revert EmptyPrize();
        verifier = verifier_;
        secretHash = secretHash_;
    }

    function claim(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        address payable recipient
    ) external {
        if (claimed) revert AlreadyClaimed();
        if (recipient == address(0)) revert ZeroRecipient();
        // Evening audit L2: paying the contract itself would lock the ETH forever (it has no withdraw).
        if (recipient == address(this)) revert RecipientIsPrize();
        uint256[2] memory pub = [secretHash, uint256(uint160(address(recipient)))];
        if (!verifier.verifyProof(a, b, c, pub)) revert InvalidProof();

        claimed = true; // effects before the external call (Day 06 / Day 09)
        uint256 amount = address(this).balance;
        emit Claimed(recipient, msg.sender, amount);
        (bool ok, ) = recipient.call{value: amount}("");
        if (!ok) revert TransferFailed();
    }
}
