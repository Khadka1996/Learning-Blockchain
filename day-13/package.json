{
  "name": "day-13-full-stack-dapp",
  "version": "1.0.0",
  "private": true,
  "description": "Day 13 of Learning Blockchain — a full-stack dApp: TipJar contract, static HTML/JS frontend with ethers.js + MetaMask, deploy script for a local Hardhat node or the Sepolia testnet, and a browser end-to-end test",
  "scripts": {
    "start": "hardhat run src/demo.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "serve": "node src/serve.js 5173",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "e2e": "hardhat test test/04-e2e.test.js",
    "lint": "eslint . && solhint \"contracts/**/*.sol\"",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "slither": "slither . --hardhat-ignore-compile",
    "clean": "hardhat clean"
  },
  "author": "Manish Khadka",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "ethers": "^6.17.0",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "hardhat": "^2.22.17",
    "solc": "^0.8.24",
    "solhint": "^5.2.0"
  }
}
